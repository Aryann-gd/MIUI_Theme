<?xml version="1.0" encoding="utf-8"?>
<Lockscreen version="1" frameRate="30" screenWidth="720" displayDesktop="false">
    <!-- ================================================================= -->
    <!-- Variables                                                         -->
    <!-- ================================================================= -->
    <Var name="touch_begin_y" type="number" expression="0" />
    <Var name="touch_drag" type="number" expression="0" />
    <Var name="is_touching" type="number" expression="0" />
    <Var name="release_offset" type="number" expression="0" />

    <Var name="spring_t" type="number">
        <VariableAnimation name="spring_anim" initPause="true" loop="false">
            <AniFrame value="0" time="0" />
            <AniFrame value="1" time="350" easeType="BackEaseOut" />
        </VariableAnimation>
    </Var>

    <Var name="clock_offset_raw" type="number" expression="max(-180, min(120, #touch_drag * 0.4))" />
    <Var name="clock_y_offset" type="number" expression="ifelse(#is_touching, #clock_offset_raw, #release_offset * (1 - #spring_t))" />
    <Var name="clock_abs_offset" type="number" expression="abs(#clock_y_offset)" />
    <Var name="clock_alpha" type="number" expression="max(140, 255 - (#clock_abs_offset * 0.6))" />
    <Var name="clock_scale" type="number" expression="max(0.90, 1 - (#clock_abs_offset * 0.0005))" />

    <!-- ================================================================= -->
    <!-- Layer 0: Full-bleed background wallpaper                          -->
    <!-- ================================================================= -->
    <Image x="0" y="0" w="720" h="1650" src="bg.png" />

    <!-- ================================================================= -->
    <!-- Layer 1: Date (above clock, clear area)                           -->
    <!-- ================================================================= -->
    <Group x="360" y="110 + #clock_y_offset" alpha="#clock_alpha" scale="#clock_scale" pivotX="0" pivotY="0">
        <DateTime x="0" y="0" color="#CCCCCC" size="30" align="center" format="dd/MM/yy  EEEE" />
    </Group>

    <!-- ================================================================= -->
    <!-- Layer 2: LARGE time digits (behind character)                     -->
    <!-- Reference style: massive condensed digits spanning full width     -->
    <!-- Positioned so the character overlaps the lower half of digits     -->
    <!-- ================================================================= -->
    <Group x="360" y="220 + #clock_y_offset" alpha="#clock_alpha" scale="#clock_scale" pivotX="0" pivotY="0">
        <!-- Hours and minutes side by side, massive size -->
        <DateTime x="-10" y="0" color="#D8DEE8" size="480" align="center" fontPath="clock.ttf" format="HH:mm" />
    </Group>

    <!-- ================================================================= -->
    <!-- Layer 3: Character foreground overlay (sits ON TOP of clock)      -->
    <!-- This creates the parallax depth: digits behind, character front   -->
    <!-- ================================================================= -->
    <Image x="0" y="350" w="720" h="1100" src="fg_character.png" />

    <!-- ================================================================= -->
    <!-- Layer 4: Bottom widgets (frosted glass circles)                   -->
    <!-- ================================================================= -->
    <!-- Left: Timer/Do-not-disturb Widget -->
    <Image x="150" y="1300" w="140" h="140" src="widget_timer.png" />

    <!-- Center: Calendar Widget with date overlay -->
    <Image x="290" y="1300" w="140" h="140" src="widget_calendar.png" />
    <DateTime x="360" y="1340" color="#FFFFFF" size="34" align="center" format="d" />
    <DateTime x="360" y="1380" color="#B0B8C4" size="22" align="center" format="EEE" />

    <!-- Right: Profile Widget -->
    <Image x="430" y="1300" w="140" h="140" src="widget_profile.png" />

    <!-- ================================================================= -->
    <!-- Layer 5: Bottom shortcuts (camera left, flashlight right)         -->
    <!-- ================================================================= -->
    <Button x="80" y="1510" w="64" h="64">
        <NormalState>
            <Image x="0" y="0" w="64" h="64" src="icon_camera.png" />
        </NormalState>
        <Triggers>
            <Trigger action="up">
                <IntentCommand action="android.media.action.STILL_IMAGE_CAMERA" />
                <ExternCommand command="unlock" />
            </Trigger>
        </Triggers>
    </Button>

    <Button x="576" y="1510" w="64" h="64">
        <NormalState>
            <Image x="0" y="0" w="64" h="64" src="icon_torch.png" />
        </NormalState>
        <Triggers>
            <Trigger action="up">
                <IntentCommand action="miui.intent.action.TOGGLE_TORCH" broadcast="true" />
            </Trigger>
        </Triggers>
    </Button>

    <!-- ================================================================= -->
    <!-- Layer 6: Touch surface for swipe interaction                      -->
    <!-- ================================================================= -->
    <Button x="0" y="110" w="720" h="1420">
        <Triggers>
            <Trigger action="down">
                <VariableCommand name="touch_begin_y" expression="#touch_y" />
                <VariableCommand name="touch_drag" expression="0" />
                <VariableCommand name="is_touching" expression="1" />
                <Command target="spring_anim.animation" value="pause" />
            </Trigger>

            <Trigger action="move">
                <VariableCommand name="touch_drag" expression="#touch_y - #touch_begin_y" />
            </Trigger>

            <Trigger action="up">
                <VariableCommand name="touch_drag" expression="#touch_y - #touch_begin_y" />
                <Trigger>
                    <Condition expression="#touch_drag &lt; -260" />
                    <ExternCommand command="unlock" />
                </Trigger>
                <Trigger>
                    <Condition expression="#touch_drag &gt;= -260" />
                    <VariableCommand name="release_offset" expression="#clock_offset_raw" />
                    <VariableCommand name="is_touching" expression="0" />
                    <Command target="spring_anim.animation" value="play(0,350)" />
                </Trigger>
            </Trigger>

            <Trigger action="cancel">
                <VariableCommand name="release_offset" expression="#clock_offset_raw" />
                <VariableCommand name="is_touching" expression="0" />
                <Command target="spring_anim.animation" value="play(0,350)" />
            </Trigger>
        </Triggers>
    </Button>

    <!-- System Unlock Fallback -->
    <Unlocker name="system_unlocker" haptic="true" bounceInitSpeed="1000" bounceAcceleration="3000">
        <StartPoint x="0" y="1400" w="720" h="120" />
        <EndPoint x="0" y="1100" minDistance="260" />
    </Unlocker>
</Lockscreen>
